[Desktop Entry]
Version=1.0
Name=Minimal
Comment=The Fluent, Modeless Code Editor for Linux
GenericName=Code Editor
Exec=minimal --gui %F
Icon=minimal
Terminal=false
Type=Application
Categories=Development;TextEditor;IDE;
MimeType=text/plain;text/x-python;text/x-c;text/x-c++;text/x-go;text/x-rust;text/javascript;text/x-typescript;application/json;text/markdown;text/x-shellscript;
Keywords=editor;code;text;terminal;ide;neovim;neovide;modeless;minimal;
StartupNotify=true
StartupWMClass=neovide
