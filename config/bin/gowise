#!/usr/bin/env bash
# ===================================================================
# Gowise - Terminal Client & Launcher Wrapper
# ===================================================================

NVIM_CLI=""
if [ -x "/usr/bin/nvim" ]; then
    NVIM_CLI="/usr/bin/nvim"
elif [ -x "/opt/homebrew/bin/nvim" ]; then
    NVIM_CLI="/opt/homebrew/bin/nvim"
elif [ -x "/usr/local/bin/nvim" ]; then
    NVIM_CLI="/usr/local/bin/nvim"
else
    NVIM_CLI="nvim"
fi

if [ -n "$NVIM" ]; then
    DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    exec "$DIR/nvim" "$@"
fi

export NVIM_APPNAME="gowise"
export NVIM_NOTTYFAST=1
exec "$NVIM_CLI" "$@"
