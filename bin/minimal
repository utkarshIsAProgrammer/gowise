#!/usr/bin/env bash
# ==============================================================================
# MINIMAL CLI Launcher (Linux OS Only)
# The Fluent, Modeless Code Editor
# Crafted by indiedev
# ==============================================================================

set -eo pipefail

# Strict Linux OS validation
if [ "$(uname -s)" != "Linux" ]; then
  echo "Error: Minimal is designed and packaged for Linux OS only." >&2
  exit 1
fi

# Set isolated application namespace
export NVIM_APPNAME="minimal"

# Add standard local bin directory to PATH
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

# Version flag
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
  echo "Minimal Code Editor (Linux OS) - crafted by indiedev"
  if command -v nvim >/dev/null 2>&1; then
    nvim --version | head -n1
  fi
  exit 0
fi

# Help flag
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "Minimal Code Editor - The Fluent, Modeless Code Editor for Linux"
  echo "Crafted by indiedev"
  echo ""
  echo "Usage:"
  echo "  minimal                     Launch editor (Homescreen / Current folder)"
  echo "  minimal <file>              Open or create file (e.g. minimal main.py)"
  echo "  minimal <directory>         Open directory in editor"
  echo "  minimal --gui [args...]     Launch in Neovide GUI mode"
  echo "  minimal --version           Show version information"
  echo "  minimal --help              Show this help message"
  echo ""
  echo "Keybindings & Features:"
  echo "  • Ctrl+S                    Save file"
  echo "  • Ctrl+N                    New file"
  echo "  • Ctrl+P                    Command / Keybindings panel"
  echo "  • Ctrl+B                    Toggle sidebar file explorer"
  echo "  • Ctrl+\`                   Toggle integrated terminal drawer"
  echo "  • Ctrl+K Ctrl+T             Open Color Themes menu"
  echo "  • Ctrl+Shift+K+T            Open Font & Appearance settings"
  echo "  • Alt+Up / Alt+Down         Move current line up or down"
  echo "  • Alt+Shift+Up / Down       Copy current line up or down"
  echo "  • Ctrl+D                    Multi-cursor / multi-selection"
  echo "  • Shift+Alt+A               Toggle multi-line block comment"
  echo "  • Ctrl+.                    Spell check suggestion & dictionary"
  exit 0
fi

# Forward file opens if called inside the integrated terminal drawer
if [ -n "$NVIM" ]; then
  if [ "$#" -eq 0 ]; then
    command nvim --headless --clean --server "$NVIM" --remote-expr "luaeval('_G.focus_editor_from_terminal()')" >/dev/null 2>&1 || true
    exit 0
  fi
  for target in "$@"; do
    if [ -n "$target" ] && [ "$target" != "--gui" ]; then
      if [[ "$target" = /* ]]; then
        abs_path="$target"
      else
        abs_path="$(realpath -m "$target" 2>/dev/null || readlink -m "$target" 2>/dev/null || echo "$PWD/$target")"
      fi
      safe_path="${abs_path//\'/\'\\\'\'}"
      command nvim --headless --clean --server "$NVIM" --remote-expr "luaeval('_G.open_file_from_terminal(_A)', '$safe_path')" >/dev/null 2>&1 || true
    fi
  done
  exit 0
fi

# Check for explicit GUI flag or GUI application launcher context
LAUNCH_GUI=false
if [ "$1" = "--gui" ]; then
  LAUNCH_GUI=true
  shift
elif [ ! -t 0 ]; then
  LAUNCH_GUI=true
fi

# If target directory provided as single argument, ensure clean entry
if [ "$#" -eq 1 ] && [ -d "$1" ]; then
  abs_dir="$(realpath -m "$1" 2>/dev/null || readlink -m "$1" 2>/dev/null || echo "$PWD/$1")"
  cd "$abs_dir"
  set -- "$abs_dir"
fi

# Launch in Neovide GUI if available and requested, otherwise terminal Neovim
if [ "$LAUNCH_GUI" = true ] && command -v neovide >/dev/null 2>&1; then
  export NEOVIDE_APP_ID="minimal"
  export NEOVIDE_WM_CLASS="minimal"
  export NEOVIDE_WM_CLASS_INSTANCE="minimal"
  NEOVIDE_ARGS=(--wayland-app-id minimal --x11-wm-class minimal --x11-wm-class-instance minimal)
  ICON_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/icons/minimal.png"
  if [ ! -f "$ICON_PATH" ]; then
    ICON_PATH="$HOME/.local/share/minimal/repo/assets/minimal.png"
  fi
  if [ -f "$ICON_PATH" ]; then
    NEOVIDE_ARGS+=(--icon "$ICON_PATH")
  fi
  exec neovide "${NEOVIDE_ARGS[@]}" "$@"
else
  exec nvim "$@"
fi
