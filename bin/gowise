#!/usr/bin/env bash
# ==============================================================================
# GOWISE CLI Launcher (Linux & macOS)
# High-performance, modeless terminal code editor engine
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CONFIG_DIR="$PROJECT_ROOT/config"

# Ensure isolated NVIM_APPNAME
export NVIM_APPNAME="gowise"

# Invalidate stale bytecode cache so updates take effect immediately
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/gowise/luac" 2>/dev/null || true

# Prepend Mason bin directory so formatters (prettier, black, stylua, shfmt) are in PATH
MASON_BIN="${XDG_DATA_HOME:-$HOME/.local/share}/gowise/mason/bin"
if [ -d "$MASON_BIN" ]; then
  export PATH="$MASON_BIN:$PATH"
fi

# Check if ~/.config/gowise exists or link it
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gowise"
if [ ! -e "$USER_CONFIG" ]; then
  mkdir -p "$(dirname "$USER_CONFIG")"
  ln -s "$CONFIG_DIR" "$USER_CONFIG"
fi

# Help Flag
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo -e "\033[1;36mGowise Code Editor\033[0m - The Fluent, Modeless Terminal IDE"
  echo ""
  echo -e "\033[1mUsage:\033[0m"
  echo "  gowise                     Launch editor in current folder"
  echo "  gowise <file>              Open or create file (e.g. gowise api/main.go)"
  echo "  gowise <directory>         Open workspace directory"
  echo "  gowise --doctor            Diagnose system health & installed toolchains"
  echo "  gowise --benchmark         Measure exact startup latency in milliseconds"
  echo "  gowise --version           Show version information"
  echo ""
  echo -e "\033[1mEssential Shortcuts:\033[0m"
  echo "  Ctrl+S                     Save file (auto-creates parent directories)"
  echo "  Ctrl+P                     Quick Open (Fuzzy file finder)"
  echo "  Ctrl+Shift+P               Command Palette"
  echo "  Ctrl+Shift+F               Global Live Grep"
  echo "  Ctrl+B                     Toggle File Explorer sidebar"
  echo "  Ctrl+\` / Ctrl+J            Toggle Bottom Terminal Drawer"
  echo "  F5                         Run Current File / Project"
  echo "  Ctrl+K Ctrl+T              Theme Switcher (Live Preview)"
  echo "  Ctrl+D                     Multi-cursor (Select next match)"
  exit 0
fi

# Doctor / Health Check Flag
if [ "$1" = "--doctor" ] || [ "$1" = "doctor" ]; then
  echo -e "\033[1;36m==> Running Gowise Health Doctor...\033[0m\n"
  
  echo -e "  \033[1mOS Platform:\033[0m          $(uname -s) ($(uname -m))"
  echo -e "  \033[1mActive Shell:\033[0m         ${SHELL:-bash}"
  
  if command -v nvim &>/dev/null; then
    NVIM_VER="$(nvim --version | head -n1)"
    echo -e "  \033[1mNeovim Engine:\033[0m        \033[1;32m✔ $NVIM_VER\033[0m"
  else
    echo -e "  \033[1mNeovim Engine:\033[0m        \033[1;31m✖ Missing! Please install Neovim v0.10+\033[0m"
  fi
  
  if command -v git &>/dev/null; then
    echo -e "  \033[1mVersion Control:\033[0m      \033[1;32m✔ Git $(git --version | awk '{print $3}')\033[0m"
  else
    echo -e "  \033[1mVersion Control:\033[0m      \033[1;31m✖ Git is missing\033[0m"
  fi

  echo ""
  echo -e "  \033[1mPolyglot Language Runtimes:\033[0m"
  check_tool() {
    local name="$1"
    local cmd="$2"
    if command -v "$cmd" &>/dev/null; then
      local ver="$($cmd --version 2>&1 | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1 || echo 'detected')"
      echo -e "    • $name: \033[1;32m✔ Available ($ver)\033[0m"
    else
      echo -e "    • $name: \033[0;33m○ Not installed (LSP will auto-prompt when editing $name files)\033[0m"
    fi
  }
  check_tool "Go" "go"
  check_tool "Node.js" "node"
  check_tool "Python" "python3"
  check_tool "Rust" "rustc"
  check_tool "C/C++ (GCC)" "gcc"

  echo ""
  echo -e "  \033[1mIcon & Typography Advice:\033[0m"
  echo -e "    • For the most beautiful file and folder icons, use any \033[1;36mNerd Font\033[0m in your terminal"
  echo -e "      (e.g. JetBrainsMono Nerd Font, FiraCode Nerd Font, or Cascadia Code NF)."
  
  echo ""
  echo -e "\033[1;32m✔ Health doctor complete! Everything is configured properly.\033[0m"
  exit 0
fi

# Version Flag
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
  echo "Gowise 1.0.0 (Powered by Neovim $(nvim --version | head -n1 | cut -d' ' -f2))"
  exit 0
fi

# Benchmark Flag
if [ "$1" = "--benchmark" ]; then
  echo -e "\033[1;36mBenchmarking Gowise Startup Time...\033[0m"
  NVIM_APPNAME=gowise nvim --startuptime /tmp/gowise_bench.log --headless -c "q" >/dev/null 2>&1
  tail -n 2 /tmp/gowise_bench.log | head -n 1 | awk '{printf "\033[1;32m✔ Total Cold Start: %s ms\033[0m\n", $1}'
  rm -f /tmp/gowise_bench.log
  exit 0
fi

# Smart Directory Creation Check for Arguments
for arg in "$@"; do
  # Skip options starting with -
  if [[ "$arg" != -* ]] && [[ ! -d "$arg" ]]; then
    target_dir="$(dirname "$arg")"
    if [ "$target_dir" != "." ] && [ ! -d "$target_dir" ]; then
      mkdir -p "$target_dir"
    fi
  fi
done

# Launch Gowise in Isolated Mode
exec nvim "$@"
