#!/usr/bin/env bash
# ==============================================================================
# GOWISE CLI Launcher (Linux & macOS)
# High-performance, modeless terminal code editor engine
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CONFIG_DIR="$PROJECT_ROOT/config"

# Ensure isolated NVIM_APPNAME
export NVIM_APPNAME="gowise"

# Check if ~/.config/gowise exists or link it
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gowise"
if [ ! -e "$USER_CONFIG" ]; then
  mkdir -p "$(dirname "$USER_CONFIG")"
  ln -s "$CONFIG_DIR" "$USER_CONFIG"
fi

# Help Flag
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo -e "\033[1;36mGowise Code Editor\033[0m - The Fluent, Modeless Terminal IDE"
  echo ""
  echo -e "\033[1mUsage:\033[0m"
  echo "  gowise                     Launch editor in current folder"
  echo "  gowise <file>              Open or create file (e.g. gowise api/main.go)"
  echo "  gowise <directory>         Open workspace directory"
  echo "  gowise --benchmark         Measure exact startup latency in milliseconds"
  echo "  gowise --version           Show version information"
  echo ""
  echo -e "\033[1mEssential Shortcuts:\033[0m"
  echo "  Ctrl+S                     Save file (auto-creates parent directories)"
  echo "  Ctrl+P                     Quick Open (Fuzzy file finder)"
  echo "  Ctrl+Shift+P               Command Palette"
  echo "  Ctrl+Shift+F               Global Live Grep"
  echo "  Ctrl+B                     Toggle File Explorer sidebar"
  echo "  Ctrl+\` / Ctrl+J            Toggle Bottom Terminal Drawer"
  echo "  F5                         Run Current File / Project"
  echo "  Ctrl+K Ctrl+T              Theme Switcher (Live Preview)"
  echo "  Ctrl+D                     Multi-cursor (Select next match)"
  exit 0
fi

# Version Flag
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
  echo "Gowise 1.0.0 (Powered by Neovim $(nvim --version | head -n1 | cut -d' ' -f2))"
  exit 0
fi

# Benchmark Flag
if [ "$1" = "--benchmark" ]; then
  echo -e "\033[1;36mBenchmarking Gowise Startup Time...\033[0m"
  nvim --clean -u "$CONFIG_DIR/init.lua" --headless -c "lua print(string.format('Gowise Core Startup: %.2f ms', (vim.uv.hrtime() - vim.g.start_time or 0) / 1e6))" -c "q" 2>&1 || true
  nvim --startuptime /tmp/gowise_bench.log --headless -c "q" >/dev/null 2>&1
  tail -n 1 /tmp/gowise_bench.log | awk '{printf "\033[1;32m✔ Total Cold Start: %s ms\033[0m\n", $1}'
  rm -f /tmp/gowise_bench.log
  exit 0
fi

# Smart Directory Creation Check for Arguments
for arg in "$@"; do
  # Skip options starting with -
  if [[ "$arg" != -* ]] && [[ ! -d "$arg" ]]; then
    target_dir="$(dirname "$arg")"
    if [ "$target_dir" != "." ] && [ ! -d "$target_dir" ]; then
      mkdir -p "$target_dir"
    fi
  fi
done

# Launch Gowise in Isolated Mode
exec nvim "$@"
